# Copy to ".env.local" for local dev, or add the same keys in Vercel → Project → Settings → Environment Variables.

# --- Order admin (recommended): manager-only page /admin/orders ---
# Strong random string; required to load orders via GET /api/orders
ADMIN_ORDERS_SECRET=

# --- Optional: WhatsApp Cloud API (server-side send). Not required if you only use wa.me links. ---
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ORDER_NOTIFY_E164=972504847599
# WHATSAPP_ALLOW_WA_ME_FALLBACK=false

# Optional: self-hosted OSRM base URL (no trailing slash). Default uses public OSRM demo.
# OSRM_ROUTE_URL=https://your-domain/route/v1/driving

# Optional: Google Geocoding API (server key only). Can improve Hebrew addresses after map pick.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_GEOCODING_API_KEY=

# Vercel note: JSON file under /data may not persist across deployments on serverless.
# For production history, plan a hosted DB (e.g. Neon, Supabase) later.

# --- Hyp (CreditGuard) — card checkout via payment page ---
# HYP_RELAY_BASE = exact API base URL from Hyp (email / onboarding). Do not guess hostnames.
# Wrong example: sandbox.creditguard.co.il → ENOTFOUND (domain does not exist).
# Either https://host (app adds /xpo/Relay) or full URL ending in /xpo/Relay — do not double the path.
# HYP_RELAY_BASE=https://YOUR-HOST-FROM-HYP.creditguard.co.il
# Terminal + merchant ID from Hyp (HYP_MERCHANT or HYP_MID)
# HYP_TERMINAL=
# HYP_MERCHANT=
# HYP_MID=
# Relay login: HYP_API_KEY as user:password, or HYP_API_USER + HYP_API_PASSWORD / HYP_API_KEY
# HYP_API_USER=
# HYP_API_PASSWORD=
# HYP_API_KEY=
# Public site URL for success/cancel redirects (required on Vercel)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# If Node reports "fetch failed" to Hyp relay: confirm HYP_RELAY_BASE, DNS, firewall.
# Some networks: NODE_OPTIONS=--dns-result-order=ipv4first
