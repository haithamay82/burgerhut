# Copy to ".env.local" for local dev, or add the same keys in Vercel → Project → Settings → Environment Variables.

# --- Order admin (recommended): manager-only page /admin/orders ---
# Strong random string; required to load orders via GET /api/orders
ADMIN_ORDERS_SECRET=

# --- Optional: WhatsApp Cloud API (server-side send). Not required if you only use wa.me links. ---
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ORDER_NOTIFY_E164=972504847599
# WHATSAPP_ALLOW_WA_ME_FALLBACK=false

# Optional: self-hosted OSRM base URL (no trailing slash). Default uses public OSRM demo.
# OSRM_ROUTE_URL=https://your-domain/route/v1/driving

# Optional: Google Geocoding API (server key only). Can improve Hebrew addresses after map pick.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_GEOCODING_API_KEY=

# --- Vercel KV (recommended for persistent admin settings on production) ---
# Add via Vercel Storage → KV and connect to project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=
# If you use Upstash Redis integration directly, this app also supports:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel note: JSON file under /data may not persist across deployments on serverless.
# This app uses Vercel KV for admin settings when KV vars exist.
# Orders/history are still file-based fallback unless migrated to DB.

# --- Hyp Pay — card checkout (Pay Protocol only; pay.hyp.co.il) ---
# Required (Terminal Settings in Hyp Pay portal):
# HYP_API_KEY=          # API KEY — plain value only; must NOT contain ":" (that was old Relay style)
# HYP_TERMINAL=         # Masof (10 digits; leading zeros if shown in portal)
# PassP — use ONE of:
# HYP_PASSP=            # preferred: PassP from the same terminal screen
# HYP_MERCHANT=         # optional: if you store PassP here instead (name is historical; value must be PassP)
# HYP_API_PASSWORD=     # optional alternative env name for PassP
#
# Optional: HYP_PAY_BASE=https://pay.hyp.co.il/p  (default)
# In Hyp portal → Terminal settings: set Success / Failure redirect URLs to your site
# (e.g. https://your-domain.com/success , /cancel , /payment-error)

# If fetch to Hyp fails: check DNS/firewall to pay.hyp.co.il (or HYP_PAY_BASE).
# Some networks: NODE_OPTIONS=--dns-result-order=ipv4first

# Dev-only (NODE_ENV !== production): /api/create-payment logs masked APISign URL + field checklist.
# Opt out: HYP_DEBUG_LOG=0 or false
# Extra env snapshot (still dev-only, not production): HYP_DEBUG_LOG=1
