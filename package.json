{
  "name": "burger-hut-ordering",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next-dev.js",
    "build": "next build",
    "start": "node scripts/run-next-start.js",
    "lint": "next lint",
    "clean": "node scripts/clean-next.js",
    "clean:win": "node scripts/free-port-win.js && node scripts/clean-next.js",
    "rebuild": "npm run clean && npm run build",
    "rebuild:win": "npm run clean:win && npm run build",
    "fresh": "npm run rebuild && npm run dev",
    "fresh:win": "npm run rebuild:win && npm run dev",
    "fresh:prod": "npm run rebuild && npm run start",
    "fresh:prod:win": "npm run rebuild:win && npm run start",
    "vercel:prod": "npx --yes vercel deploy --prod",
    "icons:pwa": "node scripts/generate-pwa-icons.js",
    "og:share": "node scripts/generate-og-share.js",
    "vapid:keys": "node scripts/gen-vapid-keys.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.37.0",
    "@vercel/blob": "^2.3.2",
    "@vercel/kv": "^3.0.0",
    "formidable": "^3.5.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "next": "14.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  }
}
